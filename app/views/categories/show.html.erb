<div class="container mt-4">
  <% if notice %>
    <div class="alert alert-success"><%= notice %></div>
  <% end %>

  <div class="card">
    <div class="card-body">
      <%= render @category %>
    </div>
  </div>

  <% if @category.products.any? %>
    <h2 class="h5 mt-4">Produtos desta categoria</h2>
    <div class="list-group mb-3">
      <% @category.products.each do |product| %>
        <%= link_to product.name, product, class: "list-group-item list-group-item-action" %>
      <% end %>
    </div>
  <% end %>

  <div class="mt-3">
    <%= link_to t("categories.edit"), edit_category_path(@category), class: "btn btn-secondary" %>
    <%= link_to t("categories.back"), categories_path, class: "btn btn-outline-secondary" %>
    <%= button_to t("categories.destroy"), @category, method: :delete, class: "btn btn-danger", form_class: "d-inline", data: { turbo_confirm: t("categories.destroy_confirm") } %>
  </div>
</div>
