<div class="container mt-4">
  <% if notice %>
    <div class="alert alert-success"><%= notice %></div>
  <% end %>

  <div class="card">
    <div class="card-body">
      <%= render @product %>
    </div>
  </div>

  <div class="mt-3">
    <%= link_to t("products.edit"), edit_product_path(@product), class: "btn btn-secondary" %>
    <%= link_to t("products.back"), products_path, class: "btn btn-outline-secondary" %>
    <%= button_to t("products.destroy"), @product, method: :delete, class: "btn btn-danger", form_class: "d-inline", data: { turbo_confirm: t("products.destroy_confirm") } %>
  </div>
</div>
